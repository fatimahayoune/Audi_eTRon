<Page x:Class="Audi_eTron.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:gif="clr-namespace:XamlAnimatedGif;assembly=XamlAnimatedGif"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="Inicio" Background="#0C0C0E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- BANNER HERO -->
            <Border CornerRadius="16" Height="330" Margin="0,0,0,35" Padding="35" BorderBrush="#22222A" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1A20" Offset="0"/>
                        <GradientStop Color="#09090B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Background="#BB0A30" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="EDICIÓN EXCLUSIVA 100% ELÉCTRICA" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Audi e-tron GT RS" Foreground="White" FontSize="38" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                        <TextBlock Text="Rendimiento deportivo extremo con 646 CV de potencia pura. Aceleración de 0 a 100 km/h en solo 3.3 segundos." 
                                   Foreground="#A0A0AB" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,20,25"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Reservar Prueba ⚡" Click="BtnReservarPrueba_Click" Background="#BB0A30" Foreground="White" FontWeight="Bold" 
                                    Height="42" Width="160" BorderBrush="Transparent" Cursor="Hand" Margin="0,0,15,0"/>
                            <Button Content="Ver Configuración" Click="BtnVerGTRS_Click" Background="Transparent" Foreground="White" FontWeight="SemiBold" 
                                    Height="42" Width="150" BorderBrush="#33333D" BorderThickness="1.5" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- GIF ANIMADO LOCAL -->
                    <Border Grid.Column="1" CornerRadius="12" ClipToBounds="True" Background="#000000" BorderBrush="#33333D" BorderThickness="1">
                        <Image gif:AnimationBehavior.SourceUri="pack://application:,,,/Imagenes/gifcoche rojo corriendo.gif" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="Modelos Destacados &amp; Promociones" Foreground="White" FontSize="24" FontWeight="Bold" Margin="5,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: Audi Q4 e-tron -->
                <Border Grid.Column="0" Background="#141418" CornerRadius="12" Margin="0,0,15,0" Padding="15" BorderBrush="#262630" BorderThickness="1">
                    <StackPanel>
                        <Border Height="160" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,15">
                            <Image Source="pack://application:,,,/Imagenes/q4.jpg" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="Audi Q4 e-tron" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="SUV compacto con hasta 520 km de autonomía cero emisiones." Foreground="#90909A" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,20"/>
                        <DockPanel>
                            <TextBlock Text="Desde 58.710 €" FontSize="16" FontWeight="Bold" Foreground="#BB0A30" VerticalAlignment="Center"/>
                            <Button Content="Ver detalle" Click="BtnVerQ4_Click" Background="#26262E" Foreground="White" DockPanel.Dock="Right" Padding="14,8" BorderBrush="Transparent" Cursor="Hand"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Audi Q8 e-tron -->
                <Border Grid.Column="1" Background="#141418" CornerRadius="12" Margin="7,0,7,0" Padding="15" BorderBrush="#262630" BorderThickness="1">
                    <StackPanel>
                        <Border Height="160" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,15">
                            <Image Source="pack://application:,,,/Imagenes/q8 etron.jpg" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="Audi Q8 e-tron" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Máximo confort de viaje, acabado de gran lujo y carga ultra rápida." Foreground="#90909A" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,20"/>
                        <DockPanel>
                            <TextBlock Text="Desde 87.500 €" FontSize="16" FontWeight="Bold" Foreground="#BB0A30" VerticalAlignment="Center"/>
                            <Button Content="Ver detalle" Click="BtnVerQ8_Click" Background="#26262E" Foreground="White" DockPanel.Dock="Right" Padding="14,8" BorderBrush="Transparent" Cursor="Hand"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Campaña Estacional -->
                <Border Grid.Column="2" Background="#141418" CornerRadius="12" Margin="15,0,0,0" Padding="15" BorderBrush="#262630" BorderThickness="1">
                    <StackPanel>
                        <Border Height="160" Background="#BB0A30" CornerRadius="8" Margin="0,0,0,15" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ PLAN MOVES III" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="HASTA 7.000€ DE AYUDA" Foreground="White" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Campaña Estacional" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Descuento gubernamental directo e instalación de Wallbox incluida." Foreground="#90909A" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,20"/>
                        <DockPanel>
                            <TextBlock Text="Promoción" FontSize="16" FontWeight="Bold" Foreground="#BB0A30" VerticalAlignment="Center"/>
                            <Button Content="Solicitar" Click="BtnSolicitarPromocion_Click" Background="#26262E" Foreground="White" DockPanel.Dock="Right" Padding="14,8" BorderBrush="Transparent" Cursor="Hand"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>