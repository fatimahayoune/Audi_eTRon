<Page x:Class="Audi_eTron.DetalleQ8Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0C0C0E" Title="Audi Q8 e-tron">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <Button Content="← Volver al Catálogo" Click="BtnVolver_Click" HorizontalAlignment="Left" 
                    Background="Transparent" Foreground="#A0A0AB" BorderBrush="Transparent" Cursor="Hand" FontSize="14" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <Border CornerRadius="12" ClipToBounds="True" Height="340" BorderBrush="#22222A" BorderThickness="1">
                        <Image Source="pack://application:,,,/Imagenes/q8 etron.jpg" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SUV INSIGNIA DE GRAN LUJO" Foreground="#BB0A30" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Audi Q8 e-tron" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Máximo confort de viaje en clase superior, refinamiento acústico supremo y carga ultra rápida." Foreground="#A0A0AB" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,25"/>

                    <Border Background="#141418" CornerRadius="10" Padding="20" Margin="0,0,0,25" BorderBrush="#262630" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Precio Base:" Foreground="#80808D" FontSize="13"/>
                                <TextBlock Text="87.500 €" Foreground="#BB0A30" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="16"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Potencia Máxima:" Foreground="#80808D" FontSize="13"/>
                                <TextBlock Text="408 CV (300 kW)" Foreground="White" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Autonomía (WLTP):" Foreground="#80808D" FontSize="13"/>
                                <TextBlock Text="Hasta 582 km" Foreground="White" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Solicitar Presupuesto Audi Q8" Click="BtnPresupuesto_Click" Background="#BB0A30" Foreground="White" FontWeight="Bold" Height="46" FontSize="14" BorderBrush="Transparent" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>